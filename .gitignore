# Dependencies
node_modules/

# Build output (gradle, etc.)
build/
dist/

# Android local build state (keep committed source, ignore transient state)
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/app/release/
android/app/debug/
android/.idea/
android/*.iml
android/app/*.iml
android/gradle/*.iml

# Auto-generated Capacitor Android assets (re-generated by `cap sync`)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# APK / AAB (built artifacts; produced by CI, never committed)
*.apk
*.aab
*.ap_
*.dex

# …but allow release APKs in releases/ (committed deliverables)
!releases/*.apk
!releases/*.aab

# Keystore (never commit signing keys)
*.keystore
*.jks
keystore.properties
